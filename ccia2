import os
import sys
import sqlite3
import subprocess

DB_PATH = "/home/k1/ccia_workspace/university.db"

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def get_stats():
    if not os.path.exists(DB_PATH):
        return 0, 0, 0, 0, 0
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM embodied_ai_reservations")
    res_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM bounty_opportunities")
    bounty_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM tailscale_fleet WHERE sim_status = 'ONLINE_STANDBY'")
    fleet_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM b2b_clients")
    b2b_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM ccia_scientific_hypotheses")
    hypo_count = cursor.fetchone()[0]
    conn.close()
    return res_count, bounty_count, fleet_count, b2b_count, hypo_count

